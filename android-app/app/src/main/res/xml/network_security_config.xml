<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug configuration - allow cleartext for local development -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    
    <!-- Production domain configuration with certificate pinning -->
    <!-- Note: Certificate pinning is managed programmatically in NetworkModule -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">cfbc.example.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
    
    <!-- Local development configuration -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.1.100</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
